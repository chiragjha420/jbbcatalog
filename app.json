{
  "expo": {
    "name": "JBB Gallery",
    "slug": "jbb-product-gallery",
    "scheme": "jbbgallery",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jbb.productgallery",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow photo access so you can add product photos and save images to your gallery.",
        "NSPhotoLibraryAddUsageDescription": "Allow photo access so you can save product images to your gallery.",
        "NSCameraUsageDescription": "Allow camera access to capture product photos."
      }
    },
    "android": {
      "package": "com.jbb.productgallery",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow photo access so you can add product photos and save images to your gallery.",
          "cameraPermission": "Allow camera access to capture product photos."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow photo access to save product photos to your gallery.",
          "savePhotosPermission": "Allow photo access to save product photos to your gallery."
        }
      ],
      [
        "react-native-share",
        {
          "ios": [
            "whatsapp"
          ],
          "android": [
            "com.whatsapp",
            "com.whatsapp.w4b"
          ],
          "enableBase64ShareAndroid": true
        }
      ],
      "expo-build-properties"
    ],
    "updates": {
      "url": "https://u.expo.dev/55ac323b-62a7-4ffa-b09a-89a5089c20c1"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "55ac323b-62a7-4ffa-b09a-89a5089c20c1"
      }
    }
  }
}
